{
  "metadata": {
    "tahap": "1.2 Pemetaan kode ANC -> SATUSEHAT",
    "diverifikasi_pada": "2026-10-02",
    "sumber": [
      "https://satusehat.kemkes.go.id/platform/docs/id/interoperability/anc/",
      "https://satusehat.kemkes.go.id/platform/docs/id/terminology/lampiran-terminologi/anc/"
    ],
    "peringatan_versi": "Riwayat perubahan di situs resmi dikonfirmasi sampai v2.5. Dampak ke pemetaan ini: (1) v2.4: display kode OC000011 (Target Kenaikan BB) berubah, display baru belum terbaca, ambil dari lampiran terminologi sebelum produksi. (2) v2.5: penutupan episode kehamilan memakai PATCH, bukan PUT, berlaku untuk tahap pengiriman. (3) v2.1 dan v2.0 mengubah kode IMT, presentasi, jumlah janin, kepala terhadap PAP, gula darah, protein urin; kode di file ini diambil dari versi terbaru, tetap uji di sandbox.",
    "status_legend": {
      "terverifikasi": "Kode diambil langsung dari playbook ANC resmi",
      "perlu_keputusan": "Ada di playbook tapi bentuk data di DB tidak cocok; harus diputuskan dulu",
      "kolom_belum_ada": "Ada di playbook tapi kolom DB belum ada",
      "tidak_ada_di_playbook_anc": "Tidak ada variabel langsung di modul ANC"
    },
    "versi_playbook_dicek": "v2.5 (2 Juli 2024), dicek 2026-10-02 dari halaman resmi",
    "keputusan_terbuka": [
      "protein_urin: form semi-kuantitatif (Negatif/+1..+4), playbook minta angka mg/dL",
      "sifilis: pilih RPR atau VDRL sebagai tes baku, atau tambah kolom jenis tes",
      "jarak_kehamilan: ubah kolom teks jadi numerik (bulan)",
      "status_tt: tambah kolom tanggal imunisasi untuk T1-T5",
      "konseling: ganti teks bebas dengan pilihan tema",
      "diagnosis_komplikasi: lengkapi ref_icd10 sesuai Lampiran 2 playbook",
      "edema: putuskan dipetakan ke pemeriksaan fisik Tungkai atau tidak dikirim"
    ]
  },
  "systems": {
    "loinc": "http://loinc.org",
    "snomed": "http://snomed.info/sct",
    "observation_category": "http://terminology.hl7.org/CodeSystem/observation-category",
    "ucum": "http://unitsofmeasure.org",
    "who_anc_custom": "http://fhir.org/guides/who/anc-cds/CodeSystem/anc-custom-codes",
    "kemkes_anc_custom": "http://terminology.kemkes.go.id/CodeSystem/anc-custom-codes",
    "kemkes_clinical_term": "http://terminology.kemkes.go.id/CodeSystem/clinical-term",
    "v3_interpretation": "http://terminology.hl7.org/CodeSystem/v3-ObservationInterpretation"
  },
  "aturan_umum": [
    "Waktu dikirim dalam UTC+00. WITA dikurangi 8 jam (contoh 17:35 WITA = 09:35 UTC).",
    "Tanggal tidak boleh sebelum 2014-06-03.",
    "Satu payload Observation = satu kode. Jangan gabung beberapa parameter dalam satu payload.",
    "Nilai 'Belum diperiksa' atau kosong: jangan kirim Observation sama sekali.",
    "Semua Observation memakai coding[0] = LOINC/SNOMED dan coding[1] = kode custom ANC."
  ],
